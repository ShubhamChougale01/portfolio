# Copy to .env and fill in. .env is gitignored — never commit real values.
# On Render, set these as environment variables on the service instead.

# --- Chatbot -----------------------------------------------------------------
# Groq API key, used by the /rag endpoint.
GROQ_API_KEY=

# --- Contact form notifications ----------------------------------------------
# The mailbox the form sends FROM (the SMTP account that authenticates).
EMAIL_HOST_USER=your.address@gmail.com

# Gmail requires a 16-character App Password here, NOT your account password:
#   Google Account > Security > 2-Step Verification > App passwords
# Leave blank and Django prints the email to the server log instead of sending,
# which is the default for local development.
EMAIL_HOST_PASSWORD=

# Address shown as the sender. Gmail will rewrite this to EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=your.address@gmail.com

# Where enquiries are delivered.
CONTACT_NOTIFY_EMAIL=shubham.chougale001@gmail.com

# --- Optional overrides (defaults shown) -------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# DJANGO_SECRET_KEY=
