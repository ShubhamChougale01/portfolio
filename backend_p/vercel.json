{
    "version": 2,
    "builds": [
      {
        "src": "backend_p/backend_p/wsgi.py",
        "use": "@vercel/python"
      }
    ],
    "routes": [
      {
        "src": "/static/(.*)",
        "dest": "staticfiles/$1"
      },
      {
        "src": "/(.*)",
        "dest": "backend_p/backend_p/wsgi.py"
      }
    ]
  }
  