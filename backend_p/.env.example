# Copy to .env and fill in. .env is gitignored — never commit real values.
# On Render, set these as environment variables on the service instead.

# --- Django core (required) --------------------------------------------------
# Required: the app refuses to start without it. Generate a fresh value with
#   python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# --- Chatbot -----------------------------------------------------------------
# Groq API key, used by the /rag endpoint.
GROQ_API_KEY=

# --- Contact form notifications ----------------------------------------------
# The mailbox the form sends FROM (the SMTP account that authenticates).
EMAIL_HOST_USER=your.address@gmail.com

# Gmail requires a 16-character App Password here, NOT your account password:
#   Google Account > Security > 2-Step Verification > App passwords
# Leave blank and Django prints the email to the server log instead of sending,
# which is the default for local development.
EMAIL_HOST_PASSWORD=

# Address shown as the sender. Gmail will rewrite this to EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=your.address@gmail.com

# Where enquiries are delivered.
CONTACT_NOTIFY_EMAIL=shubhh1012@gmail.com

# --- Optional overrides (defaults shown) -------------------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# Comma-separated hostnames the backend will answer on.
# DJANGO_ALLOWED_HOSTS=portfolio-backend-g68o.onrender.com,localhost,127.0.0.1
